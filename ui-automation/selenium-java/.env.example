# ─── Logging Configuration ───────────────────────────
LOG_LEVEL=DEBUG
LOG_DIR=target/logs
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true

# ─── Environment ─────────────────────────────────────
ENV=QA
BROWSER=chrome
HEADLESS=false
BASE_URL=https://www.saucedemo.com

# ─── Account ─────────────────────────────────────
SAUCEDEMO_USERNAME=
SAUCEDEMO_PASSWORD=

# ─── AI HEALERS ─────────────────────────────────────
AI_HEALER_ENABLED=true
AI_HEALER_PROVIDER=CLAUDE_CODE, OLLAMA, OPENAI
AI_HEALER_MODEL=ai_model_placeholder
AI_HEALER_API_KEY=api_key_placeholder